{
  "name": "agent-transit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Un petit monde pixel art pour les agents Codex et Claude Code.",
  "scripts": {
    "start": "node bridge/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs install",
    "hooks:remove": "node scripts/install-hooks.mjs remove",
    "export": "node scripts/export.mjs",
    "assets": "node scripts/export-assets.mjs",
    "install:pc": "powershell -NoProfile -ExecutionPolicy Bypass -File Install.ps1",
    "uninstall:pc": "powershell -NoProfile -ExecutionPolicy Bypass -File Uninstall.ps1",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-startup.ps1",
    "startup:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-startup.ps1 -Remove"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9"
  }
}
